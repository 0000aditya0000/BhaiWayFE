{
  "expo": {
    "name": "BhaiWay",
    "slug": "BhaiWayFE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bhaiwayfe",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhaiway.app",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow BhaiWay to access your camera to take a profile picture.",
        "NSPhotoLibraryUsageDescription": "Allow BhaiWay to access your photos to set your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Allow BhaiWay to save photos to your library.",
        "NSLocationWhenInUseUsageDescription": "Allow BhaiWay to use your location to suggest nearby destinations.",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.bhaiway.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googlePlacesApiKey": "",
      "googleMapsApiKey": "",
      "router": {},
      "cloudinaryCloudName": "",
      "cloudinaryUploadPreset": "",
      "msg91WidgetId": "",
      "msg91AuthToken": "",
      "eas": {
        "projectId": "0b5df897-5c40-4adf-b956-550fd7c65877"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BhaiWay to access your photos to set your profile picture.",
          "cameraPermission": "Allow BhaiWay to access your camera to take a profile picture."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BhaiWay to use your location to suggest nearby destinations."
        }
      ]
    ]
  }
}
