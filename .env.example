# ─── Local API / Demo mode ──────────────────────────────────────────────────
# ─── Real backend (two-device Regular Ride live tracking) ───────────────────
# EXPO_PUBLIC_USE_MOCKS=false
# EXPO_PUBLIC_DEMO_MODE=false
# EXPO_PUBLIC_API_BASE_URL=https://api.bhaiway.com
# Socket.IO namespace URL (NOT a REST path):
# EXPO_PUBLIC_REALTIME_URL=https://api.bhaiway.com/tracking
# Restart after changes: npx expo start -c
#
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_DEMO_MODE=true
# EXPO_PUBLIC_API_URL=https://api.bhaiway.com
EXPO_PUBLIC_API_BASE_URL=https://api.bhaiway.com
EXPO_PUBLIC_REALTIME_TRANSPORT=demo
# Optional Socket.IO namespace for Regular Ride live tracking.
# Must end with /tracking — defaults to {API host}/tracking when unset.
# EXPO_PUBLIC_REALTIME_URL=https://api.bhaiway.com/tracking
# Live driver GPS (/tracking/*) always uses the real API above — not in-memory demo —
# so rider phones can see the car after the driver taps Start Ride.

# ─── Push notifications (FCM via Expo Notifications) ────────────────────────
# Requires a development/production build (not Expo Go).
# Place Firebase *client* app configs at repo root (gitignored):
#   google-services.json       → Android package com.bhaiway.app
#   GoogleService-Info.plist   → iOS bundle com.bhaiway.app
# Never put Firebase Admin / backend service-account JSON in this repo.
# Device register: POST /notifications/devices  (Bearer JWT)
# Device logout:   DELETE /notifications/devices/:token
# Optional push diagnostics on a release APK (logcat):
# EXPO_PUBLIC_PUSH_DEBUG=1
#
# 1. MSG91 panel → OTP widget → enable Mobile Integration
# 2. Paste widget id + auth token below
# 3. Restart: npx expo start -c
# true = real SMS OTP via MSG91 (disables mock OTP bypass).
EXPO_PUBLIC_USE_MSG91_OTP=true
EXPO_PUBLIC_MSG91_WIDGET_ID=YOUR_MSG91_WIDGET_ID
EXPO_PUBLIC_MSG91_AUTH_TOKEN=YOUR_MSG91_AUTH_TOKEN

# ─── Google Maps / Places ───────────────────────────────────────────────────
# true = skip Google Maps tiles + Places (OSM/Photon search + map placeholder).
# Defaults to true when both keys below are empty.
EXPO_PUBLIC_BYPASS_GOOGLE_MAPS=true
#
# Create a key in Google Cloud Console with billing enabled.
# Enable only what the app uses:
#   - Maps SDK for Android
#   - Maps SDK for iOS
#   - Places API (New) — autocomplete / place details
#   - Geocoding API — reverse geocode on map pin drop
# Restrict the key by bundle id (iOS: com.bhaiway.app) / package (Android: com.bhaiway.app)
#
# Preferred (Expo public) — or alias GOOGLE_MAPS_API_KEY (also accepted):
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
#
# After setting a real key, set BYPASS=false (or omit it — empty keys default bypass on):
# EXPO_PUBLIC_BYPASS_GOOGLE_MAPS=false
#
# app.config.js injects these into ios/android Maps config automatically.
# After changing keys: npx expo start -c
#
# NOTE: Backend CreateRideDto currently stores source/destination as text only.
# Coordinates selected in the app are cached on-device for map display.
# Passenger↔driver live GPS sync still requires a backend location channel.

# ─── Cloudinary (client uploads use UNSIGNED preset only) ───────────────────
# Create an unsigned upload preset in Cloudinary Console → Settings → Upload
# Folder mode: Dynamic (app sends folder=bhaiway/...)
# NEVER put CLOUDINARY_API_SECRET in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=mzh4sidd
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bhaiway_upload
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_TIMEOUT_MS=60000

# ─── Wallet mock payment (development only) ────────────────────────────────
# Must match backend PAYMENT_GATEWAY_WEBHOOK_SECRET when PAYMENT_GATEWAY_PROVIDER=mock.
# Signs canonical string: amount=...&currency=...&gatewayOrderId=...&status=...
# Header: x-payment-signature (HMAC-SHA256 hex). Callback must NOT send JWT.
# NEVER ship production webhook secrets in store builds.
# EXPO_PUBLIC_MOCK_PAYMENT_WEBHOOK_SECRET=BhaiWay_Test_Webhook_7f4c9a2eD81mQ6xP3vR5tY9kL2wN8sZ
