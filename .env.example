# ─── Local API / Demo mode ──────────────────────────────────────────────────
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_DEMO_MODE=true
# EXPO_PUBLIC_API_URL=https://bhaiway-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=https://bhaiway-backend.onrender.com
EXPO_PUBLIC_REALTIME_TRANSPORT=demo
# EXPO_PUBLIC_REALTIME_URL=wss://realtime.bhaiway.dev/ws

# ─── MSG91 SendOTP (real SMS OTP) ───────────────────────────────────────────
# 1. MSG91 panel → OTP widget → enable Mobile Integration
# 2. Paste widget id + auth token below
# 3. Restart: npx expo start -c
# true = real SMS OTP via MSG91 (disables mock OTP bypass).
EXPO_PUBLIC_USE_MSG91_OTP=true
EXPO_PUBLIC_MSG91_WIDGET_ID=YOUR_MSG91_WIDGET_ID
EXPO_PUBLIC_MSG91_AUTH_TOKEN=YOUR_MSG91_AUTH_TOKEN

# ─── Google Maps / Places ───────────────────────────────────────────────────
# true = skip Google Maps tiles + Places (OSM/Photon search + map placeholder).
# Defaults to true when both keys below are empty.
EXPO_PUBLIC_BYPASS_GOOGLE_MAPS=true
#
# Create a key in Google Cloud Console with billing enabled.
# Enable: Maps SDK for iOS, Maps SDK for Android, Places API (New), Geocoding API
# Restrict the key by bundle id (iOS: com.bhaiway.app) / package (Android: com.bhaiway.app)
#
# You can use the SAME key for both variables, then set BYPASS=false:
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
#
# app.config.js injects these into ios/android Maps config automatically.
# After changing keys: npx expo start -c

# ─── Cloudinary (client uploads use UNSIGNED preset only) ───────────────────
# Create an unsigned upload preset in Cloudinary Console → Settings → Upload
# Folder mode: Dynamic (app sends folder=bhaiway/...)
# NEVER put CLOUDINARY_API_SECRET in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=mzh4sidd
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bhaiway_upload
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_TIMEOUT_MS=60000
